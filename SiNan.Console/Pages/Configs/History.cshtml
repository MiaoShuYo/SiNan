@page
@model SiNan.Console.Pages.Configs.HistoryModel
@{
    ViewData["Title"] = L["Title.ConfigHistory"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["ConfigHistory.Eyebrow"]</p>
        <h1>@Model.Key</h1>
        <p class="muted">@L["ConfigHistory.Meta", Model.Namespace, Model.Group]</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Configs/Details" asp-route-namespace="@Model.Namespace" asp-route-group="@Model.Group" asp-route-key="@Model.Key">@L["Action.BackToDetails"]</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="panel">
    <div class="panel-title">@L["Panel.History"]</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Table.Version"]</th>
                    <th>@L["Table.PublishedAt"]</th>
                    <th>@L["Table.PublishedBy"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.History.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">@L["Empty.History"]</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.History)
                {
                    <tr>
                        <td>@item.Version</td>
                        <td>@item.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(item.PublishedBy ?? "-")</td>
                        <td>
                            <form method="post" asp-page-handler="Rollback" class="inline-form">
                                <input type="hidden" name="namespace" value="@Model.Namespace" />
                                <input type="hidden" name="group" value="@Model.Group" />
                                <input type="hidden" name="key" value="@Model.Key" />
                                <input type="hidden" name="version" value="@item.Version" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">@L["Action.Rollback"]</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
