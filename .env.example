# Copy this file to .env and fill in the actual values before running docker-compose.apikey.yml

# MySQL root password
MYSQL_ROOT_PASSWORD=replace-with-strong-db-password

# SiNan Server API keys
# Admin key: full access (IsAdmin=true, no namespace/group/action restrictions)
SINAN_ADMIN_KEY=replace-with-strong-admin-key

# App key: restricted to default namespace / DEFAULT_GROUP
# Allowed actions: registry.register, registry.deregister, registry.heartbeat, registry.read, config.read
SINAN_APP_KEY=replace-with-strong-app-key

# SiNan Console admin account (created on first boot)
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=replace-with-strong-console-password
